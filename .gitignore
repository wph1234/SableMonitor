# MacOS DS_Store files
.DS_Store

# Gradle cache folder
.gradle

# Gradle build folder
build

# IntelliJ
out/
.idea
*.iml
# mpeltonen/sbt-idea plugin
.idea_modules/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Common working directory
run
# Minimal dedicated server used by `gradlew runVerifyServer`
run-verify

# Local native build workspace (cloned sable/rapier, vendored crates, cargo home)
.native-src/
.cargo-home/

# Python bytecode (native/tools/*.py)
__pycache__/
*.pyc

# The patched native library is distributed as a GitHub release attachment, not in git:
# it is a ~1.7 MB binary per Sable version. Rebuild it (native/README.md §4) or download it
# from the release page and drop it here before `gradlew build`.
src/main/resources/natives/

